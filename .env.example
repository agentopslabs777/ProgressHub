# ============================================================================
# Training Management and Learning Progress Platform - Environment Configuration
# ============================================================================

# Database Configuration:
# Neon Cloud PostgreSQL (recommended for production and cloud-synced local dev):
# DATABASE_URL=postgresql://user:password@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Or Local SQLite database (works out-of-the-box on Windows with zero setup):
DATABASE_URL=sqlite:///./training_platform.db
# Or Local PostgreSQL (installed locally or via Docker):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/training_platform

# JWT Authentication
JWT_SECRET_KEY=super-secret-production-random-key-change-me-training-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Storage (stored privately outside public web directory)
UPLOAD_DIRECTORY=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Platform URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=https://localhost:5173

# Razorpay Integration (Leave empty if not configured; real credentials required for live checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo Test Account Credentials (for backend/init_db.py)
ADMIN_EMAIL=admin@training.local
ADMIN_PASSWORD=AdminPass123!
EMPLOYEE_EMAIL=employee@training.local
EMPLOYEE_PASSWORD=EmployeePass123!
STUDENT_EMAIL=student@training.local
STUDENT_PASSWORD=StudentPass123!
